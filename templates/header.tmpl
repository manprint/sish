{{ define "header" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>sish</title>

    <!--
      All third-party assets are version-pinned, served from a single origin and
      guarded with Subresource Integrity, so a compromised or substituted CDN
      response cannot execute in the admin console. jQuery was pinned at 3.3.1,
      which is affected by CVE-2019-11358 (prototype pollution) and
      CVE-2020-11022 / CVE-2020-11023 (XSS via .html() with crafted markup) —
      and the audit page does feed generated markup through .html().
    -->
    <!-- Bootstrap Start -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.1/umd/popper.min.js"
            integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.2/js/bootstrap.bundle.min.js"
            integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/4.6.2/sandstone/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-Eupoe5ruAMD7NxGMjQh2mais+H/sXG7oos1rIYKpJtxGT5b/ww3NcBtMi1pD2rYu"
          crossorigin="anonymous" referrerpolicy="no-referrer">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet"
          integrity="sha384-wvfXpqpZZVQGK6TAh5PVlGOfQNHSoD2xbE+QkPxCAFlNEevoEH3Sl0sibVcOQVnN"
          crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- Bootstrap End -->

    <!-- Knockout Start -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/knockout/3.5.1/knockout-latest.js"
            integrity="sha384-VdFvmZuSjtiHvlbElVyr7sn90u3l0vjXzagUiVrpbDWUCOEfA0NqWukQVRtjfnnr"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Knockout End -->

    <style>
        #pageContainer {
            padding-top: 60px;
        }

        .navbar {
            max-height: 60px !important
        }
    </style>

    <link rel="icon" href="data:;base64,iVBORw0KGgo=">

    <!-- The console token is carried in the query string, so suppress Referer
         to keep it from leaking to any origin a forwarded page links out to. -->
    <meta name="referrer" content="no-referrer">

    <script type="text/javascript">
        $(function() {
            var params = new URLSearchParams(window.location.search);
            var token = params.get('x-authorization');
            if (token) {
                $('#consoleLink').attr('href', '/_sish/console?x-authorization=' + encodeURIComponent(token));
                $('#historyLink').attr('href', '/_sish/history?x-authorization=' + encodeURIComponent(token));
                $('#auditLink').attr('href', '/_sish/audit?x-authorization=' + encodeURIComponent(token));
                $('#logsLink').attr('href', '/_sish/logs?x-authorization=' + encodeURIComponent(token));
                $('#editkeysLink').attr('href', '/_sish/editkeys?x-authorization=' + encodeURIComponent(token));
                $('#editusersLink').attr('href', '/_sish/editusers?x-authorization=' + encodeURIComponent(token));
                $('#editheadersLink').attr('href', '/_sish/editheaders?x-authorization=' + encodeURIComponent(token));
                $('#editcensusLink').attr('href', '/_sish/editcensus?x-authorization=' + encodeURIComponent(token));
                $('#censusLink').attr('href', '/_sish/census?x-authorization=' + encodeURIComponent(token));
                $('#internalLink').attr('href', '/_sish/internal?x-authorization=' + encodeURIComponent(token));
            }
        });
    </script>
</head>

<body>
<nav class="navbar navbar-expand-md fixed-top navbar-dark bg-primary" role="navigation">
    <a id="consoleLink" class="navbar-brand mr-3" href="/_sish/console">sish</a>
    {{ if .ShowHistory }}
    <a id="historyLink" class="navbar-brand" href="/_sish/history">history</a>
    {{ end }}
    {{ if .ShowAudit }}
    <a id="auditLink" class="navbar-brand" href="/_sish/audit">audit</a>
    {{ end }}
    {{ if .ShowLogs }}
    <a id="logsLink" class="navbar-brand" href="/_sish/logs">logs</a>
    {{ end }}
    {{ if .ShowEditKeys }}
    <a id="editkeysLink" class="navbar-brand" href="/_sish/editkeys">editkeys</a>
    {{ end }}
    {{ if .ShowEditUsers }}
    <a id="editusersLink" class="navbar-brand" href="/_sish/editusers">editusers</a>
    {{ end }}
    {{ if .ShowEditHeaders }}
    <a id="editheadersLink" class="navbar-brand" href="/_sish/editheaders">headers</a>
    {{ end }}
    {{ if .ShowEditCensus }}
    <a id="editcensusLink" class="navbar-brand" href="/_sish/editcensus">editcensus</a>
    {{ end }}
    {{ if .ShowCensus }}
    <a id="censusLink" class="navbar-brand" href="/_sish/census">census</a>
    {{ end }}
    {{ if .ShowInternal }}
    <a id="internalLink" class="navbar-brand" href="/_sish/internal">internal</a>
    {{ end }}
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbar" aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbar">
        <ul class="navbar-nav mr-auto">
            <li class="nav-item">
                <!--
                <a class="nav-link" href="/_sish/console">Home</a>
                -->
            </li>
        </ul>
        <ul class="navbar-nav flex-row ml-md-auto d-none d-md-flex">
            <li class="nav-item">
                <!--
                <a class="nav-link" href="/_sish/console"><i class="fa fa-home"></i> Home</a>
                -->
            </li>
        </ul>
    </div>
</nav>
<div id="pageContainer" class="container-fluid">
{{ end }}
